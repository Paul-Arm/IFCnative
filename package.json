{
  "name": "ifcnative",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "postinstall": "node ./scripts/sync-web-ifc-wasm.js",
    "sync-web-ifc-wasm": "node ./scripts/sync-web-ifc-wasm.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "native:win": "dotnet run --project NativeWindows/IFCnative.NativeWindows.csproj -c Debug",
    "native:build:win": "dotnet publish NativeWindows/IFCnative.NativeWindows.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o native-release/win-x64",
    "lint": "expo lint",
    "test:ifc": "tsx --test tests/ifc.test.ts"
  },
  "dependencies": {
    "@pierre/diffs": "^1.1.21",
    "@pierre/trees": "^1.0.0-beta.3",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.16",
    "expo-device": "~55.0.16",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-web-browser": "~55.0.15",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "react-resizable-panels": "^4.11.0",
    "three": "^0.184.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.184.1",
    "babel-preset-expo": "^55.0.21",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
