{
  "name": "ifcnative",
  "version": "1.3.0",
  "description": "Desktop IFC builder and viewer built with Vite, React, and Electron.",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.5.1"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "electron:build": "tsc -p src-electron/tsconfig.json",
    "electron:dev": "npm run electron:build && concurrently -k -s first -n vite,electron \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "npm run build && npm run electron:build",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win zip",
    "desktop:installer": "npm run desktop:build && electron-builder --win nsis",
    "desktop:portable": "npm run desktop:build && electron-builder --win portable",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "postinstall": "node ./scripts/sync-web-ifc-wasm.js && node ./scripts/patch-thatopen-fragments.js && node ./scripts/patch-react-dnd-react19.js",
    "sync-web-ifc-wasm": "node ./scripts/sync-web-ifc-wasm.js",
    "patch-thatopen-fragments": "node ./scripts/patch-thatopen-fragments.js",
    "patch-react-dnd-react19": "node ./scripts/patch-react-dnd-react19.js",
    "react:build": "vite build",
    "native:build:win": "vite build",
    "lint": "eslint . --max-warnings=0",
    "test:ifc": "tsx --test tests/ifc.test.ts tests/catalog.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@pierre/trees": "^1.0.0-beta.3",
    "@tailwindcss/vite": "^4.3.0",
    "@thatopen/components": "^3.4.6",
    "@thatopen/fragments": "^3.4.5",
    "@thatopen/ui": "^3.4.1",
    "@thatopen/ui-obc": "^3.4.2",
    "@xyflow/react": "^12.10.2",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-mosaic-component": "^6.1.1",
    "shadcn": "^4.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "web-ifc": "0.0.77",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.7.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.3",
    "wait-on": "^9.0.10"
  },
  "private": true,
  "build": {
    "appId": "com.mkp.ifcnative.desktop",
    "productName": "IFCnative",
    "directories": {
      "output": "release/electron"
    },
    "npmRebuild": false,
    "extraMetadata": {
      "dependencies": {}
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "IFCnative-${version}-portable.exe"
    }
  }
}
