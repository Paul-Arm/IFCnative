# Ergänzung für die .env des OpenProject-Compose auf dem Server (neben
# docker-compose.yml und docker-compose.override.yml). Die übrigen Werte
# des offiziellen Setups (SECRET_KEY_BASE, OPENPROJECT_HOST__NAME, …)
# bleiben unverändert.

# Image aus build-image.ps1 (letzte Ausgabe des Skripts). Für ein Update
# neuen Tag eintragen, für ein Rollback den vorherigen.
IFC_HUB_OPENPROJECT_IMAGE=ifcnative/openproject-ifc-hub:17.7.2-ifchub-0000000

# never = Image per "docker load" übertragen (Standard),
# missing = Image liegt in einer Registry (docker compose pull holt es).
IFC_HUB_PULL_POLICY=never

# Adresse des Hubs, wie der BROWSER sie öffnet.
IFC_HUB_URL=http://hub.example.local:8787

# Gemeinsames Secret mit dem Hub (dort OPENPROJECT_SHARED_SECRET), >= 32
# Zeichen, z. B. `openssl rand -hex 32`. Nicht das aus der lokalen
# Testumgebung wiederverwenden.
IFC_HUB_SHARED_SECRET=change-me-to-at-least-32-characters

# Nur falls der OpenProject-Server den Hub-Namen nicht per DNS auflöst
# (z. B. ifc-hub.dokploy.local hinter Traefik): Name + IP des Dokploy-Hosts
# als fester Hosts-Eintrag in den Containern.
#IFC_HUB_HOSTNAME=ifc-hub.dokploy.local
#IFC_HUB_HOST_IP=10.0.0.20

# IP(s) des Hubs aus Sicht der OpenProject-Container, kommagetrennt
# (SSRF-Schutz von OpenProject). Auch nötig, wenn der Hub auf demselben
# Rechner läuft.
IFC_HUB_SSRF_ALLOWLIST=10.0.0.10
