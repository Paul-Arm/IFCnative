# Kopieren nach .env und Werte ersetzen (z. B. `openssl rand -hex 32`).
# Die Datei wird von docker compose UND vom Hub (npm run dev:openproject)
# gelesen.

# OpenProject (Rails) — beliebiger langer Zufallswert
OPENPROJECT_SECRET_KEY_BASE=change-me

# Gemeinsames Secret Plugin <-> Hub, mindestens 32 Zeichen.
# Hub: OPENPROJECT_SHARED_SECRET, Plugin: IFC_HUB_SHARED_SECRET (compose reicht es durch)
OPENPROJECT_SHARED_SECRET=change-me-to-at-least-32-characters

# Hub: Adresse, unter der der Browser OpenProject öffnet (frame-ancestors)
OPENPROJECT_URL=http://localhost:8080
# Hub: Adresse, unter der der Hub-SERVER OpenProject erreicht (Abgleich-
# Webhook). Leer = OPENPROJECT_URL; lokal passt das (Hub nativ, OpenProject
# auf localhost:8080).
# OPENPROJECT_INTERNAL_URL=http://localhost:8080

# Plugin: Adresse, unter der der Browser den Hub erreicht
IFC_HUB_URL=http://localhost:8787

# Speichertyp "IFC Hub": IP des Hubs aus Sicht des OpenProject-Containers
# (SSRF-Schutz). Docker Desktop: host.docker.internal = 192.168.65.254
IFC_HUB_SSRF_ALLOWLIST=192.168.65.254

# Image: "full" = mit Angular-Neubau (Upload aus OpenProject), "plugin" = schnell
OPENPROJECT_BUILD_TARGET=full
# Node-Heap für den Angular-Build (MB) — muss in den Docker-Speicher passen
NODE_HEAP_MB=6144
