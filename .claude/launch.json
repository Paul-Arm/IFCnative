{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ifc-vcs-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "start"
      ],
      "port": 8787,
      "autoPort": true
    },
    {
      "name": "editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "editor",
        "run",
        "start"
      ],
      "port": 5173
    },
    {
      "name": "hub-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server/web",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}
