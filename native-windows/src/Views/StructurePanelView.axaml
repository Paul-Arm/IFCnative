<UserControl x:Class="IFCnative.NativeWindows.Views.StructurePanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:IFCnative.NativeWindows.Views">
  <UserControl.Styles>
    <Style Selector="ToggleButton.collapseHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ToggleButton.collapseHeader:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.collapseHeader:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.collapseHeader PathIcon">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="ToggleButton.collapseHeader:checked PathIcon">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="8" RowSpacing="8">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionTitle" Text="Structure" />
      <TextBox Watermark="Search" Text="{Binding SearchText}" />
    </StackPanel>

    <ListBox Grid.Row="1"
             x:Name="TreeListBox"
             Classes="fileTree"
             SelectionMode="Multiple"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding SelectedRow}"
             SelectionChanged="OnTreeSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="{DynamicResource FileTreeRowHeight}"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                VerticalAlignment="Center"
                Background="Transparent"
                ToolTip.Tip="{Binding TypeLabel}">
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding Guides}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Width="{DynamicResource FileTreeGuideWidth}" Height="{DynamicResource FileTreeRowHeight}">
                    <Rectangle Width="1"
                               Fill="#4B5548"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding Continues}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="1"
                  Width="{DynamicResource FileTreeGuideWidth}"
                  Height="{DynamicResource FileTreeRowHeight}"
                  IsVisible="{Binding ShowConnector}">
              <Rectangle Width="1"
                         Height="12"
                         Fill="#4B5548"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top" />
              <Rectangle Width="1"
                         Height="12"
                         Fill="#4B5548"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         IsVisible="{Binding ShowLowerConnector}" />
              <Rectangle Width="9"
                         Height="1"
                         Fill="#4B5548"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Column="2" Width="{DynamicResource FileTreeChevronSlot}" Height="{DynamicResource FileTreeRowHeight}">
              <Button Width="{DynamicResource FileTreeChevronSlot}"
                      Height="22"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Command="{Binding ToggleCommand}"
                      IsVisible="{Binding HasChildren}">
                <PathIcon Width="{DynamicResource FileTreeChevronSize}"
                          Height="{DynamicResource FileTreeChevronSize}"
                          Foreground="#A4AA9F"
                          Data="{Binding ChevronData}" />
              </Button>
            </Border>

            <views:IfcTreeIconControl Grid.Column="3"
                                      Width="{DynamicResource FileTreeIconSize}"
                                      Height="{DynamicResource FileTreeIconSize}"
                                      Margin="1,0,7,0"
                                      VerticalAlignment="Center"
                                      EntityType="{Binding EntityType}" />

            <TextBlock Grid.Column="4"
                       FontSize="{DynamicResource FontSizeTree}"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ToggleButton Grid.Row="2"
                  x:Name="PinnedToggle"
                  Classes="collapseHeader"
                  IsChecked="{Binding IsPinnedSectionExpanded, Mode=TwoWay}"
                  ToolTip.Tip="Show or hide pinned entities">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Width="10"
                  Height="10"
                  Foreground="#A4AA9F"
                  Data="M4.5,5.5 L8,9 L11.5,5.5 L12.5,6.5 L8,11 L3.5,6.5 Z" />
        <TextBlock Classes="sectionTitle" Text="Pinned" />
        <TextBlock Classes="caption"
                   VerticalAlignment="Center"
                   Text="{Binding Bookmarks.Count}" />
      </StackPanel>
    </ToggleButton>
    <ListBox Grid.Row="3"
             Classes="compact"
             MaxHeight="110"
             IsVisible="{Binding #PinnedToggle.IsChecked}"
             ItemsSource="{Binding Bookmarks}"
             SelectedItem="{Binding SelectedBookmark}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="{DynamicResource FileTreeRowHeight}"
                ColumnDefinitions="Auto,*"
                Background="Transparent"
                ToolTip.Tip="{Binding TypeLabel}">
            <views:IfcTreeIconControl Height="{DynamicResource FileTreeIconSize}"
                                      Width="{DynamicResource FileTreeIconSize}"
                                      Margin="1,0,7,0"
                                      VerticalAlignment="Center"
                                      EntityType="{Binding EntityType}" />
            <TextBlock Grid.Column="1"
                       FontSize="{DynamicResource FontSizeTree}"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
