<UserControl x:Class="IFCnative.NativeWindows.Views.ModelsPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="6">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Spacing="1" VerticalAlignment="Center">
        <TextBlock Classes="sectionTitle" Text="Models" />
        <TextBlock Classes="caption" FontSize="{DynamicResource FontSizeTreeMeta}" Text="{Binding SessionSummary}" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="ghost"
              Padding="8,3"
              MinHeight="24"
              FontSize="{DynamicResource FontSizeCaption}"
              VerticalAlignment="Center"
              Content="Add IFC..."
              Command="{Binding AddIfcCommand}"
              ToolTip.Tip="Load another IFC into the session (Ctrl+Shift+O)" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Documents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="modelCard"
                    Classes.active="{Binding IsActive}"
                    Margin="0,2"
                    PointerPressed="OnModelCardPressed"
                    ToolTip.Tip="{Binding SourcePath}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Ellipse Width="7"
                         Height="7"
                         VerticalAlignment="Center"
                         Classes="activeDot"
                         Classes.active="{Binding IsActive}" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                  <TextBlock FontSize="{DynamicResource FontSizeTree}"
                             FontWeight="SemiBold"
                             Text="{Binding FileName}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />
                  <TextBlock FontSize="{DynamicResource FontSizeTreeMeta}"
                             Foreground="#9AA59A"
                             Text="{Binding Meta}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />
                </StackPanel>
                <ToggleButton Grid.Column="2"
                              Classes="eye"
                              IsChecked="{Binding IsVisibleInViewport, Mode=TwoWay}"
                              ToolTip.Tip="Show in 3D viewport">
                  <PathIcon Data="M12,5.5 C6.3,5.5 2.6,10.7 2,12 C2.6,13.3 6.3,18.5 12,18.5 C17.7,18.5 21.4,13.3 22,12 C21.4,10.7 17.7,5.5 12,5.5 Z M12,8.2 A3.8,3.8 0 1 1 11.99,8.2 Z" />
                </ToggleButton>
                <Button Grid.Column="3"
                        Classes="ghost"
                        Padding="5,3"
                        MinHeight="24"
                        VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveModelCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Remove model from session">
                  <PathIcon Width="10"
                            Height="10"
                            Data="M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Classes="caption"
               FontSize="{DynamicResource FontSizeTreeMeta}"
               Text="{Binding ActiveHint}"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
