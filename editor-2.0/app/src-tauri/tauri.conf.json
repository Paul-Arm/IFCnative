{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IFCnative Editor",
  "version": "2.0.0",
  "identifier": "com.mkp.ifcnative.editor2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IFCnative Editor 2.0",
        "width": 1440,
        "height": 920,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Nativer IFC-Editor",
    "longDescription": "IFCnative Editor 2.0 — IFC-Modelle öffnen, prüfen, bearbeiten und exportieren.",
    "fileAssociations": [
      {
        "ext": ["ifc"],
        "name": "IFC-Modell",
        "description": "Industry Foundation Classes Modell",
        "mimeType": "application/x-step",
        "role": "Editor"
      },
      {
        "ext": ["ifczip"],
        "name": "IFC-Modell (komprimiert)",
        "description": "Komprimiertes IFC-Modell",
        "mimeType": "application/zip",
        "role": "Editor"
      },
      {
        "ext": ["ifcx"],
        "name": "IFCX-Modell",
        "description": "IFC5 (IFCX) Modell",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": ["ids"],
        "name": "IDS-Prüfregeln",
        "description": "Information Delivery Specification",
        "mimeType": "application/xml",
        "role": "Viewer"
      },
      {
        "ext": ["bcf", "bcfzip"],
        "name": "BCF-Themen",
        "description": "BIM Collaboration Format",
        "mimeType": "application/zip",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater-deaktiviert": {
      "aktiv": false,
      "hinweis": "Vorlage für das Auto-Update (E12), bewusst INAKTIV. JSON kennt keine Kommentare, deshalb steht die Konfiguration unter einem Schlüssel, den kein Plugin liest. Aktivieren: Schlüssel in \"updater\" umbenennen, \"aktiv\"/\"hinweis\" entfernen, echten pubkey und Endpoint eintragen, tauri-plugin-updater in Cargo.toml und lib.rs freischalten. Schritte im README der App.",
      "endpoints": [
        "https://github.com/ORG/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "PLATZHALTER-PUBKEY — aus `npm run tauri signer generate`; Signierung/Zertifikat sind mit E12 zurückgestellt, ohne echten Schlüssel darf der Updater nicht laufen",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
