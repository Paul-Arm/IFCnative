{
  "name": "@ifcnative/server-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI for the IFC version control server (Nuxt SPA).",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "node scripts/sync-fragments-worker.mjs && node scripts/sync-cad-workers.mjs && nuxt generate",
    "postinstall": "nuxt prepare && node scripts/sync-fragments-worker.mjs && node scripts/sync-cad-workers.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@mlightcad/cad-simple-viewer": "1.7.1",
    "@mlightcad/data-model": "^1.14.12",
    "@mlightcad/libredwg-converter": "^3.14.12",
    "@mlightcad/mtext-renderer": "^0.12.13",
    "@mlightcad/three-renderer": "1.7.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@thatopen/components": "~3.4.6",
    "@thatopen/fragments": "~3.4.5",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.11",
    "nuxt": "^4.2.2",
    "three": "^0.184.0",
    "vue": "^3.5.0",
    "web-ifc": "^0.0.77"
  },
  "overrides": {
    "three": "$three",
    "lodash-es": "$lodash-es"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
