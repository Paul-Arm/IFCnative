<Window x:Class="IFCnative.NativeWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:IFCnative.NativeWindows.Models"
        Title="IFCnative — Windows Native"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172033" />
        <SolidColorBrush x:Key="BorderBrush" Color="#263244" />
        <SolidColorBrush x:Key="TextBrush" Color="#e5e7eb" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9ca3af" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563eb" />
        <SolidColorBrush x:Key="ControlBrush" Color="#0b1220" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#1e293b" />
        <SolidColorBrush x:Key="ControlSelectedBrush" Color="#1d4ed8" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748b" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3b82f6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1d4ed8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1e293b" />
                    <Setter Property="BorderBrush" Value="#334155" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SelectionBrush" Value="{StaticResource ControlSelectedBrush}" />
            <Setter Property="SelectionTextBrush" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlSelectedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1e293b" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#020617" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:IfcTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Click="OpenIfc_Click" InputGestureText="Ctrl+O" />
                <MenuItem Header="Load _Sample" Click="LoadSample_Click" />
                <Separator />
                <MenuItem Header="_Export…" Click="ExportIfc_Click" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ShowModelPaneMenuItem" Header="Show _Model pane" IsCheckable="True" IsChecked="True" Click="PaneVisibility_Click" />
                <MenuItem x:Name="ShowViewportPaneMenuItem" Header="Show _Viewport pane" IsCheckable="True" IsChecked="True" Click="PaneVisibility_Click" />
                <MenuItem x:Name="ShowInspectorPaneMenuItem" Header="Show _Inspector pane" IsCheckable="True" IsChecked="True" Click="PaneVisibility_Click" />
                <Separator />
                <MenuItem Header="Reset _Layout" Click="ResetLayout_Click" />
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#020617" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="Open IFC" Click="OpenIfc_Click" />
                    <Button x:Name="CancelOpenButton" Content="Cancel" Click="CancelOpen_Click" Background="#991b1b" BorderBrush="#ef4444" IsEnabled="False" />
                    <Button x:Name="LoadSampleButton" Content="Load sample" Click="LoadSample_Click" Background="#334155" BorderBrush="#475569" />
                    <Button x:Name="ExportButton" Content="Export IFC" Click="ExportIfc_Click" Background="#16a34a" BorderBrush="#22c55e" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="IFCnative Windows Native" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Ready" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Schema: " Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="SchemaText" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="Entities: " Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="EntityCountText" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ModelColumn" Width="330" MinWidth="260" />
                <ColumnDefinition x:Name="ModelSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="ViewportColumn" Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="InspectorColumn" Width="380" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ModelPane" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Model" FontSize="16" FontWeight="SemiBold" />
                        <TextBox x:Name="EntitySearchBox" Margin="0,10,0,10" TextChanged="EntitySearch_TextChanged" ToolTip="Search by STEP id, type, name, or GlobalId" />
                    </StackPanel>
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="Spatial">
                            <TreeView x:Name="StructureTree" SelectedItemChanged="StructureTree_SelectedItemChanged" />
                        </TabItem>
                        <TabItem Header="Types">
                            <ListBox x:Name="TypeList" DisplayMemberPath="Label" SelectionChanged="TypeList_SelectionChanged" />
                        </TabItem>
                        <TabItem Header="Pinned">
                            <ListBox x:Name="BookmarkList" DisplayMemberPath="Label" SelectionChanged="BookmarkList_SelectionChanged" />
                        </TabItem>
                        <TabItem Header="Recent">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Top" Content="Clear missing" Click="ClearMissingRecent_Click" Margin="0,0,0,8" Background="#334155" BorderBrush="#475569" />
                                <ListBox x:Name="RecentFileList" DisplayMemberPath="Label" SelectionChanged="RecentFileList_SelectionChanged" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Capabilities">
                            <ListBox x:Name="CapabilityList" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ModelSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border x:Name="ViewportPane" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="ViewportTitle" Text="Native Viewport" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                            <Button Content="Fit" Click="FitViewport_Click" Background="#334155" BorderBrush="#475569" />
                            <Button Content="Reset" Click="ResetViewport_Click" Background="#334155" BorderBrush="#475569" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#020617" BorderBrush="#1f2937" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewport3D x:Name="NativeViewport3D" Margin="8" ClipToBounds="True" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#99020617" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" MaxWidth="420">
                                <StackPanel>
                                    <TextBlock Text="Native 3D preview" Foreground="#cbd5e1" FontSize="18" FontWeight="SemiBold" />
                                    <ListBox x:Name="ViewportGeometryList" DisplayMemberPath="Label" Margin="0,8,0,0" MaxHeight="150" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="#0b1220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                                <TextBlock x:Name="ViewportInfo" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border x:Name="InspectorPane" Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" x:Name="InspectorTitle" Text="Inspector" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="Draft">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Changeset name" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="ChangesetNameBox" Margin="0,2,0,8" ToolTip="Optional label stored with the applied draft checkpoint" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ApplyDraftButton" Content="Apply" Click="ApplyDraft_Click" IsEnabled="False" />
                                        <Button x:Name="DiscardDraftButton" Content="Discard" Click="DiscardDraft_Click" Background="#991b1b" BorderBrush="#ef4444" IsEnabled="False" />
                                        <Button x:Name="UndoDraftButton" Content="Undo" Click="UndoDraft_Click" IsEnabled="False" />
                                        <Button x:Name="RedoDraftButton" Content="Redo" Click="RedoDraft_Click" IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="DraftList" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Entity">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,8,8">
                                    <TextBlock Text="STEP id" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="EntityIdText" FontWeight="SemiBold" Margin="0,0,0,8" />

                                    <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="EntityTypeText" FontWeight="SemiBold" Margin="0,0,0,8" />

                                    <TextBlock Text="GlobalId" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="EntityGlobalIdText" FontWeight="SemiBold" Margin="0,0,0,8" />

                                    <TextBlock Text="Spatial path" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="EntityPathText" FontWeight="SemiBold" Margin="0,0,0,12" />

                                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="EntityNameBox" Margin="0,2,0,8" />

                                    <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="EntityDescriptionBox" Margin="0,2,0,8" />

                                    <TextBlock Text="Raw arguments" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="RawArgsBox"
                                             Margin="0,2,0,12"
                                             MinHeight="120"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save entity edit" Click="SaveEdit_Click" />
                                        <Button x:Name="ToggleBookmarkButton" Content="Pin selection" Click="ToggleBookmark_Click" Background="#334155" BorderBrush="#475569" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Spatial edit">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,8,8">
                                    <ListBox x:Name="SpatialEditList" MinHeight="80" Margin="0,0,0,12" />
                                    <TextBlock Text="Parent STEP id" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="SpatialParentBox" Margin="0,2,0,12" ToolTip="Enter a spatial parent id, for example #30" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveSpatialParentButton" Content="Save spatial parent" Click="SaveSpatialParent_Click" IsEnabled="False" />
                                        <Button x:Name="DetachSpatialParentButton" Content="Detach from parent" Click="DetachSpatialParent_Click" IsEnabled="False" Background="#7f1d1d" BorderBrush="#991b1b" />
                                    </StackPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,10" />
                                    <TextBlock Text="Create child product" FontWeight="SemiBold" />
                                    <TextBlock Text="Adds a placed product under the selected spatial parent with a rectangle/cylinder body draft." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8" />
                                    <TextBlock Text="IFC type" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="NewProductTypeBox" Text="IFCBUILDINGELEMENTPROXY" Margin="0,2,0,8" />
                                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="NewProductNameBox" Text="New native product" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CreateRectangleProductButton" Content="Create rectangle product" Click="CreateRectangleProduct_Click" IsEnabled="False" />
                                        <Button x:Name="CreateCylinderProductButton" Content="Create cylinder product" Click="CreateCylinderProduct_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Placement">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,8,8">
                                    <ListBox x:Name="PlacementList" MinHeight="80" Margin="0,0,0,12" />
                                    <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="PlacementXBox" Margin="0,2,0,8" />
                                    <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="PlacementYBox" Margin="0,2,0,8" />
                                    <TextBlock Text="Z" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="PlacementZBox" Margin="0,2,0,12" />
                                    <Button x:Name="SavePlacementButton" Content="Save placement" Click="SavePlacement_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Representation">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="Body preset dimensions" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Width / diameter" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="BodyWidthBox" Text="1" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Depth" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="BodyDepthBox" Text="1" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Height" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="BodyHeightBox" Text="1" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AssignRectangleBodyButton" Content="Stage rectangle body" Click="AssignRectangleBody_Click" IsEnabled="False" />
                                        <Button x:Name="AssignCylinderBodyButton" Content="Stage cylinder body" Click="AssignCylinderBody_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                        <Button x:Name="CreateOpeningVoidButton" Content="Create opening void" Click="CreateOpeningVoid_Click" Margin="8,0,0,0" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                        <Button x:Name="CreateFillingElementButton" Content="Create filling element" Click="CreateFillingElement_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="RepresentationList" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Psets/Qto">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="Raw value" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="PropertyValueBox" Margin="0,2,0,8" />
                                    <Button x:Name="SavePropertyButton" Content="Save property value" Click="SaveProperty_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,10" />
                                    <TextBlock Text="Property templates" FontWeight="SemiBold" />
                                    <TextBlock Text="Stage a common Pset or base Qto assignment for the selected product. Qto uses the body dimension boxes." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AddCommonPsetButton" Content="Add common Pset" Click="AddCommonPset_Click" IsEnabled="False" />
                                        <Button x:Name="AddBaseQtoButton" Content="Add base Qto" Click="AddBaseQto_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="PropertyList" DisplayMemberPath="Label" SelectionChanged="PropertyList_SelectionChanged" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Types">
                            <ListBox x:Name="TypeAssignmentList" />
                        </TabItem>
                        <TabItem Header="Resources">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="Resource assignments" FontWeight="SemiBold" />
                                    <TextBlock Text="Stage simple IFC material, classification, document, or library references for the selected product." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8" />
                                    <TextBlock Text="Resource name" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="MaterialNameBox" Text="Native material" Margin="0,2,0,8" />
                                    <TextBlock Text="Identification/code" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="ResourceIdentificationBox" Text="NATIVE-REF" Margin="0,2,0,8" />
                                    <WrapPanel>
                                        <Button x:Name="AddMaterialButton" Content="Add material" Click="AddMaterial_Click" IsEnabled="False" />
                                        <Button x:Name="AddClassificationButton" Content="Add classification" Click="AddClassification_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                        <Button x:Name="AddDocumentButton" Content="Add document" Click="AddDocument_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                        <Button x:Name="AddLibraryButton" Content="Add library" Click="AddLibrary_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                    </WrapPanel>
                                </StackPanel>
                                <ListBox x:Name="ResourceList" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Units">
                            <ListBox x:Name="UnitList" />
                        </TabItem>
                        <TabItem Header="Relationships">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="Create/edit indexed relationship" FontWeight="SemiBold" />
                                    <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    <TextBox x:Name="RelationshipTypeBox" Text="IFCRELDEFINESBYPROPERTIES" Margin="0,2,0,8" />
                                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="RelationshipNameBox" Text="Native relationship" Margin="0,2,0,8" />
                                    <TextBlock Text="Source IDs" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="RelationshipSourceBox" Margin="0,2,0,8" />
                                    <TextBlock Text="Target IDs" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="RelationshipTargetBox" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CreateRelationshipButton" Content="Create relationship" Click="CreateRelationship_Click" IsEnabled="False" />
                                        <Button x:Name="SaveRelationshipButton" Content="Save relationship endpoints" Click="SaveRelationship_Click" IsEnabled="False" />
                                        <Button x:Name="DeleteRelationshipButton" Content="Delete relationship" Click="DeleteRelationship_Click" Margin="8,0,0,0" IsEnabled="False" Background="#7f1d1d" BorderBrush="#991b1b" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="ConnectElementButton" Content="Connect selected to target" Click="ConnectElement_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                        <Button x:Name="DisconnectElementButton" Content="Disconnect selected/target" Click="DisconnectElement_Click" IsEnabled="False" Background="#334155" BorderBrush="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="RelationshipList" DisplayMemberPath="Label" SelectionChanged="RelationshipList_SelectionChanged" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Graph">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Selected entity relationship neighborhood" Foreground="{StaticResource MutedBrush}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GraphFilterBox"
                                                 Grid.Column="0"
                                                 Margin="0,0,8,0"
                                                 TextChanged="GraphFilter_TextChanged"
                                                 ToolTip="Filter by relationship type, STEP id, entity type, name, or GlobalId" />
                                        <ComboBox x:Name="GraphDepthBox" Grid.Column="1" SelectionChanged="GraphDepth_SelectionChanged" SelectedIndex="0">
                                            <ComboBoxItem Content="Depth 1" Tag="1" />
                                            <ComboBoxItem Content="Depth 2" Tag="2" />
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Fit graph" Click="FitGraph_Click" Background="#334155" BorderBrush="#475569" />
                                        <Button Content="Reset zoom" Click="ResetGraph_Click" Background="#334155" BorderBrush="#475569" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="#020617" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                    <Canvas x:Name="RelationshipGraphCanvas"
                                            Background="#020617"
                                            MouseLeftButtonDown="RelationshipGraphCanvas_MouseLeftButtonDown"
                                            MouseLeftButtonUp="RelationshipGraphCanvas_MouseLeftButtonUp"
                                            MouseMove="RelationshipGraphCanvas_MouseMove"
                                            MouseWheel="RelationshipGraphCanvas_MouseWheel" />
                                </Border>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Incoming">
                            <ListBox x:Name="IncomingList" />
                        </TabItem>
                        <TabItem Header="Diagnostics">
                            <DockPanel LastChildFill="True" Margin="0,8,8,8">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Filter diagnostics" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="DiagnosticFilterBox"
                                             Margin="0,2,0,0"
                                             TextChanged="DiagnosticFilter_TextChanged"
                                             ToolTip="Filter by severity, message text, or repair suggestion, for example Error, Warning, GlobalId, placement" />
                                </StackPanel>
                                <ListBox x:Name="DiagnosticsList" DisplayMemberPath="Label" SelectionChanged="DiagnosticsList_SelectionChanged" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
