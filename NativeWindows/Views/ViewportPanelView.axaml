<UserControl x:Class="IFCnative.NativeWindows.Views.ViewportPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:IFCnative.NativeWindows.Views">
  <Grid RowDefinitions="Auto,*,170" Margin="8" RowSpacing="8">
    <Border Classes="surface" Padding="10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
          <TextBlock Classes="caption" Text="{Binding Summary}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="caption" Text="native mesh" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="surface" ClipToBounds="True">
      <views:ViewportPreviewControl Meshes="{Binding Meshes}" />
    </Border>

    <ListBox Grid.Row="2"
             Classes="compact"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
