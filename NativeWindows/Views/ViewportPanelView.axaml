<UserControl x:Class="IFCnative.NativeWindows.Views.ViewportPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:IFCnative.NativeWindows.Views">
  <Grid RowDefinitions="Auto,*,170" Margin="8" RowSpacing="8">
    <Border Classes="surface" Padding="10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
          <TextBlock Classes="caption" Text="{Binding Summary}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding BackendName}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="surface" ClipToBounds="True">
      <Grid>
        <views:ViewportPreviewControl x:Name="ViewportCanvas"
                                      Scene="{Binding RenderScene}"
                                      SelectedProductId="{Binding SelectedProductId}"
                                      AntiAliasing="{Binding AntiAliasing}"
                                      HideSpaces="{Binding HideSpaces}"
                                      FieldOfView="{Binding FieldOfView}"
                                      NearPlane="{Binding NearPlane}"
                                      FarPlane="{Binding FarPlane}"
                                      InteractionMode="{Binding InteractionMode}"
                                      CanTransformSelection="{Binding CanTransformSelection}"
                                      ShowFpsCounter="{Binding ShowFpsCounter}"
                                      ProductPicked="OnViewportProductPicked"
                                      ProductTransformCommitted="OnViewportProductTransformCommitted"
                                      FpsUpdated="OnViewportFpsUpdated" />
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8"
                Padding="6,3"
                Background="#DD151A14"
                BorderBrush="#38433B"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="{Binding ShowFpsCounter}">
          <TextBlock Classes="caption"
                     Text="{Binding FpsText}"
                     MinWidth="190"
                     TextAlignment="Left"
                     TextWrapping="NoWrap" />
        </Border>
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Padding="4"
                Background="#DD151A14"
                BorderBrush="#38433B"
                BorderThickness="1"
                CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="compact" Padding="8,3" Content="Select" Click="OnViewportSelectMode" />
            <Button Classes="compact" Padding="8,3" Content="Move" Click="OnViewportMoveMode" IsEnabled="{Binding CanTransformSelection}" />
            <Button Classes="compact" Padding="8,3" Content="Rotate" Click="OnViewportRotateMode" IsEnabled="{Binding CanTransformSelection}" />
            <Button Classes="compact" Padding="8,3" Content="Fit" Click="OnViewportFit" />
            <Button Classes="compact" Padding="8,3" Content="Frame" Click="OnViewportFrame" />
            <Button Classes="compact" Padding="8,3" Content="Iso" Click="OnViewportIso" />
            <Button Classes="compact" Padding="8,3" Content="Top" Click="OnViewportTop" />
            <Button Classes="compact" Padding="8,3" Content="Front" Click="OnViewportFront" />
            <Button Classes="compact" Padding="8,3" Content="Right" Click="OnViewportRight" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ListBox Grid.Row="2"
             Classes="compact"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
