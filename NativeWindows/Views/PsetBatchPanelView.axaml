<UserControl x:Class="IFCnative.NativeWindows.Views.PsetBatchPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Styles>
    <Style Selector="TextBox.distinct">
      <Setter Property="Foreground" Value="#E0A53B" />
    </Style>
    <Style Selector="TextBlock.coverage">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="#A4AA9F" />
    </Style>
    <Style Selector="TextBlock.coverage.partial">
      <Setter Property="Foreground" Value="#E0A53B" />
    </Style>
    <Style Selector="TextBox.cell">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
    <Border Classes="surface" Padding="10,8">
      <StackPanel Spacing="4">
        <TextBlock Classes="sectionTitle" Text="Batch Psets" />
        <TextBlock Classes="caption" Text="{Binding Summary}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="subtle" Padding="8">
      <StackPanel Spacing="4">
        <TextBlock Classes="caption" Text="New Pset" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Watermark="Pset_Name" Text="{Binding NewPsetName}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddEmptyPsetCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1"
                  Classes="primary"
                  Content="Add"
                  Command="{Binding AddEmptyPsetCommand}"
                  ToolTip.Tip="Add an empty Pset to every selected object" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Classes="subtle"
            Padding="12"
            IsVisible="{Binding !HasSelection}">
      <TextBlock Classes="caption"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 Text="Select one or more objects in the structure tree (Ctrl/Shift-click) to edit their property sets." />
    </Border>

    <ScrollViewer Grid.Row="2" IsVisible="{Binding HasSelection}">
      <ItemsControl ItemsSource="{Binding Blocks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="surface" Padding="0">
              <StackPanel>
                <Border Background="#1D201B" BorderBrush="#343A30" BorderThickness="0,0,0,1" Padding="8,5">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="1"
                               Classes="coverage"
                               Classes.partial="{Binding IsPartial}"
                               VerticalAlignment="Center"
                               Text="{Binding Coverage}"
                               ToolTip.Tip="Objects carrying this Pset / objects selected" />
                  </Grid>
                </Border>

                <TextBlock Classes="caption"
                           Margin="8,6"
                           Text="No properties."
                           IsVisible="{Binding !HasProperties}" />

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasProperties}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Background="#1B1E19">
                      <Border Width="170" Padding="8,4">
                        <TextBlock Classes="caption" Text="Property" />
                      </Border>
                      <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="150" Padding="8,4" ToolTip.Tip="{Binding Title}">
                              <TextBlock FontWeight="SemiBold"
                                         Text="{Binding Label}"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="NoWrap" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Properties}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#2C322A" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                              <Border Width="170"
                                      Padding="8,3"
                                      Background="Transparent"
                                      ContextRequested="OnPropertyLabelContextRequested"
                                      ToolTip.Tip="Right-click to rename the property or set the data type for the whole row">
                                <TextBlock Classes="caption"
                                           Foreground="#D8DCD2"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                              </Border>
                              <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Width="150" Padding="2">
                                      <TextBox Classes="cell"
                                               Classes.distinct="{Binding IsDistinct}"
                                               Text="{Binding ValueDraft}"
                                               Watermark="—"
                                               ToolTip.Tip="Right-click to set the data type"
                                               LostFocus="OnCellLostFocus"
                                               KeyDown="OnCellKeyDown"
                                               ContextRequested="OnCellContextRequested" />
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Spacer so the overlay horizontal scrollbar never covers the last row. -->
                    <Border Height="14" />
                  </StackPanel>
                </ScrollViewer>

                <Border BorderBrush="#343A30"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        IsVisible="{Binding CanAddProperty}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             MinHeight="28"
                             Watermark="New property"
                             Text="{Binding NewPropertyName}" />
                    <ComboBox Grid.Column="1"
                              MinHeight="28"
                              MinWidth="118"
                              FontSize="{DynamicResource FontSizeCaption}"
                              ItemsSource="{Binding ValueTypeOptions}"
                              SelectedItem="{Binding NewPropertyType, Mode=TwoWay}"
                              ToolTip.Tip="Data type" />
                    <Button Grid.Column="2"
                            Classes="primary"
                            Content="Add"
                            Command="{Binding AddPropertyCommand}"
                            ToolTip.Tip="Add this property to every selected object that has this Pset" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
