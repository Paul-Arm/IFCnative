<UserControl x:Class="IFCnative.NativeWindows.Views.DraftPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionTitle" Text="Draft" />
      <TextBox Watermark="Changeset name" Text="{Binding ChangesetName}" />
    </StackPanel>

    <WrapPanel Grid.Row="1">
      <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
      <Button Classes="danger" Content="Discard" Command="{Binding DiscardCommand}" IsEnabled="{Binding CanApply}" />
      <Button Classes="ghost" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
      <Button Classes="ghost" Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
    </WrapPanel>

    <ListBox Grid.Row="2" Classes="compact" ItemsSource="{Binding Lines}" />
  </Grid>
</UserControl>
