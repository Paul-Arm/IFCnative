<UserControl x:Class="IFCnative.NativeWindows.Views.StructurePanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:IFCnative.NativeWindows.Views">
  <Grid RowDefinitions="Auto,*,Auto,150" Margin="8" RowSpacing="8">
    <StackPanel Spacing="6">
      <TextBlock Classes="sectionTitle" Text="Structure" />
      <TextBox Watermark="Search" Text="{Binding SearchText}" />
    </StackPanel>

    <ListBox Grid.Row="1"
             x:Name="TreeListBox"
             Classes="fileTree"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding SelectedRow}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="{DynamicResource FileTreeRowHeight}"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                VerticalAlignment="Center">
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding Guides}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Width="{DynamicResource FileTreeGuideWidth}" Height="{DynamicResource FileTreeRowHeight}">
                    <Rectangle Width="1"
                               Fill="#4B5548"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding Continues}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="1"
                  Width="{DynamicResource FileTreeGuideWidth}"
                  Height="{DynamicResource FileTreeRowHeight}"
                  IsVisible="{Binding ShowConnector}">
              <Rectangle Width="1"
                         Height="12"
                         Fill="#4B5548"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top" />
              <Rectangle Width="1"
                         Height="12"
                         Fill="#4B5548"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         IsVisible="{Binding ShowLowerConnector}" />
              <Rectangle Width="9"
                         Height="1"
                         Fill="#4B5548"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Column="2" Width="{DynamicResource FileTreeChevronSlot}" Height="{DynamicResource FileTreeRowHeight}">
              <Button Width="{DynamicResource FileTreeChevronSlot}"
                      Height="22"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Command="{Binding ToggleCommand}"
                      IsVisible="{Binding HasChildren}">
                <PathIcon Width="{DynamicResource FileTreeChevronSize}"
                          Height="{DynamicResource FileTreeChevronSize}"
                          Foreground="#A4AA9F"
                          Data="{Binding ChevronData}" />
              </Button>
            </Border>

            <views:IfcTreeIconControl Grid.Column="3"
                                      Width="{DynamicResource FileTreeIconSize}"
                                      Height="{DynamicResource FileTreeIconSize}"
                                      Margin="1,0,7,0"
                                      VerticalAlignment="Center"
                                      EntityType="{Binding EntityType}" />

            <TextBlock Grid.Column="4"
                       FontSize="{DynamicResource FontSizeTree}"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Grid.Column="5"
                       Margin="12,0,2,0"
                       FontSize="{DynamicResource FontSizeTreeMeta}"
                       Foreground="#9AA59A"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding TypeLabel}"
                       TextAlignment="Right"
                       TextWrapping="NoWrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2" Classes="sectionTitle" Text="Pinned" />
    <ListBox Grid.Row="3"
             Classes="compact"
             ItemsSource="{Binding Bookmarks}"
             SelectedItem="{Binding SelectedBookmark}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="{DynamicResource FileTreeRowHeight}" ColumnDefinitions="Auto,*,Auto">
            <views:IfcTreeIconControl Height="{DynamicResource FileTreeIconSize}"
                                      Width="{DynamicResource FileTreeIconSize}"
                                      Margin="1,0,7,0"
                                      VerticalAlignment="Center"
                                      EntityType="{Binding EntityType}" />
            <TextBlock Grid.Column="1"
                       FontSize="{DynamicResource FontSizeTree}"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Grid.Column="2"
                       Margin="10,0,0,0"
                       FontSize="{DynamicResource FontSizeTreeMeta}"
                       Foreground="#9AA59A"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding TypeLabel}"
                       TextAlignment="Right"
                       TextWrapping="NoWrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
