<UserControl x:Class="IFCnative.NativeWindows.Views.DiagnosticsPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="8">
    <Border Classes="surface" Padding="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Watermark="Filter diagnostics" Text="{Binding FilterText}" />
        <Button Grid.Column="1" Classes="primary" Content="Repair" Command="{Binding RepairCommand}" />
      </Grid>
    </Border>

    <ListBox Grid.Row="1"
             Classes="compact"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedDiagnostic}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Classes="subtle" Margin="0,0,0,4" Padding="8,5">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding Severity}" />
              <TextBlock Classes="caption" Text="{Binding Message}" />
              <TextBlock Classes="caption" Text="{Binding Suggestion}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
