<Application x:Class="IFCnative.NativeWindows.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockThemes="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent"
             xmlns:local="using:IFCnative.NativeWindows"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <dockThemes:DockFluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
      <Setter Property="Background" Value="#181A17" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E8EAE4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A4AA9F" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="#A4AA9F" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="#22251F" />
      <Setter Property="BorderBrush" Value="#3A4035" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.subtle">
      <Setter Property="Background" Value="#1D201B" />
      <Setter Property="BorderBrush" Value="#343A30" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2F7D68" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#8A3A35" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#2A2F28" />
      <Setter Property="Foreground" Value="#E8EAE4" />
    </Style>
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="#C9CEC4" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33404636" />
    </Style>
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#2F7D68" />
    </Style>
    <Style Selector="ToggleButton.icon:checked PathIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#2A2F28" />
      <Setter Property="BorderBrush" Value="#3A4035" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="#C9CEC4" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.chip.accent">
      <Setter Property="Background" Value="#1E2D29" />
      <Setter Property="BorderBrush" Value="#2F7D68" />
    </Style>
    <Style Selector="Border.chip.accent TextBlock">
      <Setter Property="Foreground" Value="#7FD7BC" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.modelCard">
      <Setter Property="Background" Value="#20231E" />
      <Setter Property="BorderBrush" Value="#343A30" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.modelCard:pointerover">
      <Setter Property="BorderBrush" Value="#4B5548" />
    </Style>
    <Style Selector="Border.modelCard.active">
      <Setter Property="BorderBrush" Value="#2F7D68" />
      <Setter Property="Background" Value="#1E2922" />
    </Style>
    <Style Selector="Ellipse.activeDot">
      <Setter Property="Fill" Value="#4B5548" />
    </Style>
    <Style Selector="Ellipse.activeDot.active">
      <Setter Property="Fill" Value="#3FCF9E" />
    </Style>
    <Style Selector="ToggleButton.eye">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.eye PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Foreground" Value="#4B5548" />
    </Style>
    <Style Selector="ToggleButton.eye:checked PathIcon">
      <Setter Property="Foreground" Value="#C9CEC4" />
    </Style>
    <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.statusLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Menu.nativeTopMenu">
      <Setter Property="Background" Value="#191D18" />
      <Setter Property="BorderBrush" Value="#343A30" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="Menu.nativeTopMenu MenuItem">
      <Setter Property="Foreground" Value="#E8EAE4" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="ListBox.fileTree">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.fileTree ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.hybridPanel">
      <Setter Property="Background" Value="#22251F" />
      <Setter Property="BorderBrush" Value="#3A4035" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.hybridHeader">
      <Setter Property="Background" Value="#1D201B" />
      <Setter Property="BorderBrush" Value="#343A30" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>
    <Style Selector="Border.hybridHero">
      <Setter Property="Background" Value="#271F1E" />
      <Setter Property="BorderBrush" Value="#6D3C38" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.hybridSection">
      <Setter Property="Background" Value="#22251F" />
      <Setter Property="BorderBrush" Value="#3A4035" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.hybridSectionHeader">
      <Setter Property="Background" Value="#1D201B" />
      <Setter Property="BorderBrush" Value="#343A30" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>
    <Style Selector="Border.hybridIcon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#242B2A" />
      <Setter Property="BorderBrush" Value="#3A4035" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.hybridStepBadge">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#1E2A2F" />
      <Setter Property="BorderBrush" Value="#2F7D68" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.graphCanvasFrame">
      <Setter Property="Background" Value="#181A17" />
      <Setter Property="BorderBrush" Value="#343A30" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.hybridIcon.red">
      <Setter Property="Background" Value="#2B1D1B" />
      <Setter Property="BorderBrush" Value="#8A3A35" />
    </Style>
    <Style Selector="Border.hybridIcon.green">
      <Setter Property="Background" Value="#1D2A22" />
      <Setter Property="BorderBrush" Value="#2F7D68" />
    </Style>
    <Style Selector="Border.hybridIcon.purple">
      <Setter Property="Background" Value="#251F2D" />
      <Setter Property="BorderBrush" Value="#68478F" />
    </Style>
    <Style Selector="Border.hybridIcon.amber">
      <Setter Property="Background" Value="#2B261A" />
      <Setter Property="BorderBrush" Value="#8A6A2D" />
    </Style>
    <Style Selector="TextBlock.hybridTitle">
      <Setter Property="Foreground" Value="#E8EAE4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
    </Style>
    <Style Selector="TextBlock.hybridBody">
      <Setter Property="Foreground" Value="#E8EAE4" />
    </Style>
    <Style Selector="TextBlock.hybridCaption">
      <Setter Property="Foreground" Value="#A4AA9F" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>
    <Style Selector="TextBlock.hybridGlyphBlue">
      <Setter Property="Foreground" Value="#77B7FF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hybridGlyphRed">
      <Setter Property="Foreground" Value="#FF8A80" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hybridGlyphGreen">
      <Setter Property="Foreground" Value="#74D38A" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hybridGlyphPurple">
      <Setter Property="Foreground" Value="#C4A3FF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hybridGlyphAmber">
      <Setter Property="Foreground" Value="#F3C26B" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.hybridList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.hybridList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Application.Styles>
</Application>
