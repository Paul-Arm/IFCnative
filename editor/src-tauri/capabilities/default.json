{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the IFCnative main window",
  "windows": ["main", "popout-*"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://auth.marxkrontal.com/*" },
        { "url": "https://portal.dev.marxkrontal.com/*" },
        { "url": "http://localhost:8000/*" },
        { "url": "http://localhost:8787/*" },
        { "url": "http://127.0.0.1:8787/*" },
        { "url": "http://ifc-hub.dokploy.local/*" }
      ]
    }
  ]
}
