# Kopieren nach .env und den Azure-Container-SAS mit Read-Berechtigung eintragen.
# Der Token wird beim Desktop-Build fest in die App übernommen.
IFCNATIVE_UPDATE_SAS_TOKEN=""

# Optional: Sentry-Projekt-DSN. Leer = Telemetrie vollständig deaktiviert.
# Wird beim Desktop-Build eingebettet; kein Sentry-API-/Auth-Token nötig.
IFCNATIVE_SENTRY_DSN=""

# Optional: separates Sentry-Projekt (React) für die Browser-Version.
VITE_IFCNATIVE_SENTRY_DSN=""
