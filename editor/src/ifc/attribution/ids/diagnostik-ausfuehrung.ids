<?xml version="1.0" encoding="UTF-8"?>
<!--
  IDS (Information Delivery Specification, buildingSMART) fuer das
  MKP-Portal-Fachmodell "Diagnostik - Ausfuehrung / Einzelergebnisse".

  Modellierer koennen ihre IFC-Datei damit VOR dem Upload pruefen,
  z. B. mit ifctester (IfcOpenShell), BIMcollab Zoom, Solibri oder usBIM.

  Nicht in IDS abbildbar und weiterhin vom Portal geprueft:
  - Eindeutigkeit der IDs (keine Duplikate)
  - Aufloesung der Referenzen (BauteilID gegen das importierte
    Bauwerksmodell; UntersuchungsbereichID, UntersuchungsstelleID,
    UntersuchungszielID und MessfeldID innerhalb der Datei)
  - "Jedes 3D-Element ist Untersuchungsstelle ODER Probe" - ein
    Entweder-oder kann IDS nicht pruefen
  - Zuordnung erweiterter Verfahrens-PSets zu genau einem Hauptverfahren
-->
<ids xmlns="http://standards.buildingsmart.org/IDS"
     xmlns:xs="http://www.w3.org/2001/XMLSchema"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>MKP-Portal Diagnostik Ausfuehrung</title>
    <version>1.1.0</version>
    <description>Anforderungen an Diagnostik-Ausfuehrungs-IFC-Dateien (Einzelergebnisse) fuer den Import in das MKP-Portal.</description>
    <date>2026-08-28</date>
  </info>
  <specifications>

    <specification name="Bauwerksbezug am IfcBuilding" identifier="DIA-A-01" ifcVersion="IFC4"
        description="Die Bauwerksnummer stellt den Bezug zum bereits importierten Bauwerksmodell her.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDING</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required" instructions="Muss der Bauwerksnummer des importierten Bauwerksmodells entsprechen.">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Bauwerk"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?Bauwerksnummer"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Diagnostik-Projekt am IfcBuilding" identifier="DIA-A-02" ifcVersion="IFC4"
        description="Das Projekt-PSet identifiziert das Diagnostik-Projekt.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDING</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required" instructions="Eindeutige Projekt-ID.">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?(Diagnostik ?)?Projekt"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?ID"/></xs:restriction>
          </baseName>
        </property>
        <property cardinality="required" instructions="Projektbezeichnung ('Bezeichnung' oder 'BezeichnungProjekt').">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?(Diagnostik ?)?Projekt"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?Bezeichnung(Projekt)?"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Untersuchungsziele am IfcBuilding" identifier="DIA-A-03" ifcVersion="IFC4"
        description="Mindestens ein PSet 'Untersuchungsziel&lt;n&gt;' mit ID und Bezeichnung am IfcBuilding.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDING</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required" instructions="ID des Untersuchungsziels.">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Untersuchungsziel[0-9]*"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?ID"/></xs:restriction>
          </baseName>
        </property>
        <property cardinality="required" instructions="Bezeichnung des Untersuchungsziels ('Bezeichnung' oder 'UntersuchungszielName').">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Untersuchungsziel[0-9]*"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?(Bezeichnung|UntersuchungszielName)"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Untersuchungsbereiche am IfcBuilding" identifier="DIA-A-07" ifcVersion="IFC4"
        description="Mindestens ein PSet 'Untersuchungsbereich&lt;n&gt;' mit ID am IfcBuilding; Untersuchungsstellen referenzieren diese Bereiche.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDING</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required" instructions="ID des Untersuchungsbereichs; wird von Untersuchungsstellen ueber 'UntersuchungsbereichID' referenziert.">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Untersuchungsbereich[0-9]*"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?ID"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Untersuchungsstellen" identifier="DIA-A-04" ifcVersion="IFC4"
        description="Untersuchungsstellen tragen in der Objektinformation die BauteilID (Bezug zum Bauwerksmodell) sowie ID, Bezeichnung und UntersuchungsbereichID.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue></name>
        </entity>
        <property>
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Objektinformation(en)?"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?BauteilID"/></xs:restriction>
          </baseName>
        </property>
      </applicability>
      <requirements>
        <property cardinality="required" instructions="Eindeutige ID der Untersuchungsstelle ('ID' oder 'IDUntersuchungsstelle'; Eindeutigkeit prueft das Portal).">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Objektinformation(en)?"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?(ID|IDUntersuchungsstelle)"/></xs:restriction>
          </baseName>
        </property>
        <property cardinality="required" instructions="Bezeichnung der Untersuchungsstelle ('Bezeichnung' oder 'BezeichnungUntersuchungsstelle').">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Objektinformation(en)?"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?(Bezeichnung|BezeichnungUntersuchungsstelle)"/></xs:restriction>
          </baseName>
        </property>
        <property cardinality="required" instructions="Referenz auf einen Untersuchungsbereich am IfcBuilding (Aufloesung prueft das Portal).">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Objektinformation(en)?"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?UntersuchungsbereichID"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Proben referenzieren ihre Untersuchungsstelle" identifier="DIA-A-05" ifcVersion="IFC4"
        description="Proben tragen die UntersuchungsstelleID; der Wert muss auf eine Untersuchungsstelle derselben Datei zeigen (Aufloesung prueft das Portal).">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue></name>
        </entity>
        <property>
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?(Probe[0-9]*|Objektinformation)"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?UntersuchungsstelleID"/></xs:restriction>
          </baseName>
        </property>
      </applicability>
      <requirements>
        <property cardinality="required" instructions="Eindeutige ID der Probe ('ID' oder 'IDProbe'; Eindeutigkeit prueft das Portal).">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?(Probe[0-9]*|Objektinformation)"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value="_?(ID|IDProbe)"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

    <specification name="Keine Untersuchungsergebnisse in der Ausfuehrung" identifier="DIA-A-06" ifcVersion="IFC4"
        description="Elemente mit dem PSet 'Untersuchungsergebnisse' gehoeren in die Importart 'Ergebnisse' und sind in Ausfuehrungs-Dateien nicht zulaessig.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="prohibited">
          <propertySet>
            <xs:restriction base="xs:string"><xs:pattern value="(Pset_|ePset_|ePSet_)?Untersuchungsergebnisse"/></xs:restriction>
          </propertySet>
          <baseName>
            <xs:restriction base="xs:string"><xs:pattern value=".*"/></xs:restriction>
          </baseName>
        </property>
      </requirements>
    </specification>

  </specifications>
</ids>
