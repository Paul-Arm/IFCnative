<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IFCnative.IfcToGlb.Cli</RootNamespace>
    <AssemblyName>ifc2glb</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Xbim's STEP parser instantiates CultureInfo("en-US") internally;
         InvariantGlobalization=true would silently zero all REAL values. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Short-lived batch process: workstation GC with aggressive memory return
         keeps the footprint low; throughput matters less than peak RSS. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IfcToGlb.Core\IfcToGlb.Core.csproj" />
  </ItemGroup>

</Project>
